# Entorno local de desarrollo. No contiene secretos.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=sqlite:///./data/local/validator.db
APP_LOAD_DEMO_FIXTURE=false
APP_DEMO_FIXTURE_PATH=data/examples/omeprazole-demo.json
# Conjunto DEMO multi-registro de la vertical de revision. Son datos de
# demostracion: no proceden de los maestros ni de CIMA. Desactivado por defecto.
APP_LOAD_SHOWCASE_FIXTURE=false
APP_SHOWCASE_FIXTURE_PATH=data/examples/showcase-demo.json
# Origenes permitidos para el frontend de desarrollo (vite en 5173).
APP_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
APP_CIMA_BASE_URL=https://cima.aemps.es/cima/rest
APP_CIMA_TIMEOUT_SECONDS=15
APP_CIMA_REQUESTS_PER_SECOND=5
APP_CIMA_MAX_RETRIES=3
APP_CIMA_BACKOFF_SECONDS=0.5
APP_CIMA_MAX_RETRY_DELAY_SECONDS=30
APP_CIMA_CACHE_DIR=data/local/cima-cache
# Lista configurable de revisores (10.1), formato `identificador:Nombre`.
# Sin entradas no se puede firmar ninguna validacion.
# GOLD-002: los dos anotadores del conjunto oro se dan de alta AQUI, con
# personas reales. Los valores de abajo son marcadores de ejemplo, no
# personas: sustituyelos antes de empezar la anotacion.
APP_REVIEWERS=["mtorres:M. Torres","jlopez:J. Lopez"]
VITE_API_BASE_URL=http://localhost:8000
