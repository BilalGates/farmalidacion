# Entorno local de desarrollo. No contiene secretos.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=sqlite:///./data/local/validator.db
APP_LOAD_DEMO_FIXTURE=false
APP_DEMO_FIXTURE_PATH=data/examples/omeprazole-demo.json
APP_CIMA_BASE_URL=https://cima.aemps.es/cima/rest
APP_CIMA_TIMEOUT_SECONDS=15
APP_CIMA_REQUESTS_PER_SECOND=5
APP_CIMA_MAX_RETRIES=3
APP_CIMA_BACKOFF_SECONDS=0.5
APP_CIMA_MAX_RETRY_DELAY_SECONDS=30
APP_CIMA_CACHE_DIR=data/local/cima-cache
VITE_API_BASE_URL=http://localhost:8000
